	showmonpic SPECIES_CHALKBOARD_3, 10, 3
	waitbuttonpress
	hidemonpic
	goto CeladonCity_Condominiums_RoofRoom_EventScript_ExitBlackboard
	end

CeladonCity_Condominiums_RoofRoom_EventScript_ExitBlackboard::
	releaseall
	end

